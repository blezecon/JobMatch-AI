# ─── AI backend ────────────────────────────────────────────────────────────────
# Which backend serves the model. One of: ollama | llamacpp | openrouter
# All three speak the OpenAI-compatible /chat/completions API.
AI_PROVIDER=ollama

# Every backend also honours <PREFIX>_BASE_URL and <PREFIX>_MODEL.
# AI_BASE_URL / AI_MODEL are the generic overrides and win over both.

# Ollama (fully local — resume never leaves your machine)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:4b

# llama.cpp `llama-server`. Point this at your LAN address to use another machine.
# llama-server ignores the model field, so LLAMACPP_MODEL is usually unnecessary.
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# LLAMACPP_MODEL=phi4.gguf

# OpenRouter, for hosted open-weight models. Only needed for this provider.
# OPENROUTER_API_KEY=sk-or-your-key-here

# ─── Optional tuning ───────────────────────────────────────────────────────────
# AI_TIMEOUT_MS=180000

# Context window requested from local servers. Prompts are clipped to fit it,
# and each local call asks for a fresh context (cache_prompt: false). Match it
# to the value you started llama-server / Ollama with.
# AI_NUM_CTX=16384
# MAX_RESUME_BYTES=5242880
# JOB_TIMEOUT_MS=12000

# ─── Job APIs ──────────────────────────────────────────────────────────────────
# No key required. Arbeitnow, Jobicy, RemoteOK and Remotive are free and key-less,
# so job search works straight after `npm install` with no configuration.
# Edit PROVIDERS in lib/jobs.ts to change which sources are queried.