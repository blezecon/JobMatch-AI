# ─── AI backend ────────────────────────────────────────────────────────────────
# Which backend serves the model. One of: ollama | llamacpp | groq | openrouter
# All four speak the OpenAI-compatible /chat/completions API.
AI_PROVIDER=ollama

# Optional overrides. Leave blank to use the provider's default URL and model.
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=openai/gpt-oss-20b

# Ollama (fully local — resume never leaves your machine)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:4b

# llama.cpp `llama-server`
# LLAMACPP_BASE_URL=http://localhost:8080/v1

# Hosted open-weight models. Needed only for the matching provider.
# GROQ_API_KEY=gsk_your_key_here
# OPENROUTER_API_KEY=sk-or-your-key-here

# ─── Optional tuning ───────────────────────────────────────────────────────────
# AI_TIMEOUT_MS=180000
# MAX_RESUME_BYTES=5242880
# JOB_TIMEOUT_MS=12000

# ─── Job APIs ──────────────────────────────────────────────────────────────────
# No key required. Arbeitnow, Jobicy, RemoteOK and Remotive are free and key-less,
# so job search works straight after `npm install` with no configuration.
# Edit PROVIDERS in lib/jobs.ts to change which sources are queried.